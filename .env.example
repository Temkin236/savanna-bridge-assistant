# Copy this file to .env. Never commit .env or paste credentials into issues or chats.

# API and AI provider
AI_PROVIDER=offline
ADDIS_API_KEY=
CLOUD_AI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=

# Channel credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=savannah_assistant3_bot
BOT_API_SECRET=change-me-bot-secret-generate-random
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Security
# Generate a unique value before using anything beyond local development.
TOKEN_SECRET=change-me-before-shared-testing
CORS_ORIGINS=http://localhost:4173,http://localhost:8080
WIDGET_TOKEN_TTL_SECONDS=3600
LINK_CODE_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=60

# Service URLs
API_BASE_URL=http://api:8000
PUBLIC_API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
API_PORT=8000
MOCK_API_PORT=4010
CONSOLE_PORT=8080
DEMO_PORT=4173
OLLAMA_PORT=11434

# Demo data
CONTENT_SOURCE=savanna-static
SAVANNA_CONTENT_PATH=/app/content
DATABASE_URL=sqlite:////data/savanna_bridge.db

# SMS remains a sandbox-only demonstration for this hackathon.
SMS_DRIVER=mock

