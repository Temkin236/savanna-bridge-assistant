# Copy this file to .env. Never commit .env or paste credentials into issues or chats.

# API and AI provider
AI_PROVIDER=offline
TTS_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Aoede
TTS_STYLE="warm, calm tutor, moderate pace, clear, unhurried"
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_SPEECH_API_KEY=
CLOUD_MODEL=gemini-2.5-flash
# Configure both server-side Groq keys. GROQ_API_KEYS may alternatively hold a
# comma-separated pool; keys are rotated on auth, rate-limit, timeout, or 5xx failures.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEYS=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL_EN=canopylabs/orpheus-v1-english
GROQ_TTS_MODEL_AR=canopylabs/orpheus-arabic-saudi

# Channel credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=savannah_assistant3_bot
BOT_API_SECRET=change-me-bot-secret-generate-random
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Security
# Generate a unique value before using anything beyond local development.
TOKEN_SECRET=change-me-before-shared-testing
# Helper / agent console credentials — change before any shared or public deployment.
# HELPER_AGENT_KEY is the server-to-server bypass key; keep it secret.
# HELPER_AUTH_STRICT=true means all browser requests to /handoff/* must carry a JWT;
# set to false only in automated CI environments that cannot POST /helper/login first.
HELPER_USERNAME=agent_sarah
HELPER_PASSWORD=savanna2026
HELPER_AGENT_KEY=change-me-helper-key
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8090,http://127.0.0.1:8090
WIDGET_TOKEN_TTL_SECONDS=3600
LINK_CODE_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=60

# Service URLs
API_BASE_URL=http://api:8000
PUBLIC_API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
API_PORT=8000
MOCK_API_PORT=4010
CONSOLE_PORT=8080
DEMO_PORT=4173

# Demo data
CONTENT_SOURCE=savanna-static
SAVANNA_CONTENT_PATH=/app/content
DATABASE_URL=sqlite:////data/savanna_bridge.db

# SMS remains a sandbox-only demonstration for this hackathon.
SMS_DRIVER=mock

